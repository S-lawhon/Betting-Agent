# Kalshi API credentials
# Get your API key from https://kalshi.com/settings/api
KALSHI_API_KEY_ID=your_kalshi_api_key_id_here
KALSHI_API_PRIVATE_KEY_PATH=path/to/your/kalshi_private_key.pem

# The Odds API key
# Get your free API key from https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Environment: "demo" or "prod"
# ALWAYS start with demo!
KALSHI_ENV=demo

# Optional: webhook URL for alerts
ALERT_WEBHOOK_URL=
