[Unit]
Description=Betting Pod Shop — six-per-day screened research timer

[Timer]
# Five passes follow the 04:05 UTC intake/triage run; the 01:10 pass drains
# survivors from the prior intake day without replaying missed work in a burst.
OnCalendar=*-*-* 01,05,09,13,17,21:10:00 UTC
# Do NOT replay a missed window. A skipped day costs one research pass; a
# burst of catch-up runs would spend the daily attempt budget on whatever
# happened to be queued during the outage, which is worse.
Persistent=false
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
