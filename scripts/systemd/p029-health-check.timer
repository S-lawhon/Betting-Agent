# P-029 heartbeat health check (timer)
#
# Hourly during Gate 0c because the shadow tape cannot be backfilled and the
# process runs close to its cgroup memory ceiling. Archive freshness remains a
# 30h content check, so hourly probes are safe while the daily archiver is
# running; `archive_unit=activating` is explicitly healthy.
#
# Persistent=true: a droplet does not sleep, but a reboot or maintenance
# window must not silently drop a run — that silence costing 35h of blindness
# is why this timer exists at all.
[Unit]
Description=Betting Pod Shop — P-029 VPS heartbeat health check (timer)

[Timer]
OnCalendar=*-*-* *:07:00 UTC
Persistent=true
RandomizedDelaySec=120
Unit=p029-health-check.service

[Install]
WantedBy=timers.target
