[Unit]
Description=Betting Pod Shop — Book Capture (1-min Kalshi order-book collector)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bettingbot
Group=bettingbot
WorkingDirectory=/opt/betting-pod-shop

# Data collector only — public unauthenticated endpoints, places no orders.
# Separate unit from betting-pod-shop / betting-live-maker so a capture bug
# cannot take down trading, and a trading restart cannot gap the capture.
#
# --rate 4.0 sized to COVERAGE, not to a round number.  The cap is
# rate*cadence*safety/reqs_per_market = 4.0*60*0.6/2 = 72 markets, which covers
# the 68 discovered on a full MLB slate with margin.  5.0 would give 90 — more
# API budget than the job needs, and on this host budget is shared.
#
# History: this ran at 2.5 (45 markets, truncating ~23) from 2026-07-20 while
# the 429 storm was being diagnosed.  Root cause turned out to be the legacy
# shared KalshiClient defaulting to 5 req/s (kalshi.rate_limit now 2), NOT this
# daemon — 98 of 98 429s came from [kalshi_client], zero from KalshiPublic.
# With that fixed and the MLB props collector throttled to 2.0, the headroom
# for full slate coverage exists.
#
# Kalshi throttles per-IP, so this competes with betting-pod-shop,
# betting-live-maker and mlb-props-collector.  The daemon halves its own rate
# on any 429 and recovers at 5%/cycle, so it yields first if that is wrong.
# Watch: journalctl -u betting-book-capture | grep 'throttling down'
ExecStart=/opt/betting-pod-shop/venv/bin/python -m scripts.run_book_capture --rate 4.0

Restart=always
RestartSec=30
ExecStartPre=/bin/sleep 5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=betting-book-capture

# Capture is strictly lower priority than trading: if the box gets tight,
# this is what should yield.
Nice=10
IOSchedulingClass=idle
MemoryMax=384M

# ── Security hardening (mirrors betting-live-maker.service) ─────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/betting-pod-shop/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
