[Unit]
Description=Betting Pod Shop — daily screened research timer

[Timer]
# After the 04:05 UTC intake/triage pass, so the queue and every packet's
# measured evidence are fresh when the screen reads them.
OnCalendar=*-*-* 05:10:00 UTC
# Do NOT replay a missed window. A skipped day costs one research pass; a
# burst of catch-up runs would spend the daily attempt budget on whatever
# happened to be queued during the outage, which is worse.
Persistent=false
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
