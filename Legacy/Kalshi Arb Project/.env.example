# ── Betting Agent — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored. NEVER commit secrets.

# ── Kalshi API credentials (RSA key — current method) ─────────────────────────
# Generate keys at: https://kalshi.com → Settings → API
KALSHI_API_KEY_ID=your-api-key-uuid-here
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
  paste your full private key here
  (multiple lines are fine — dotenv handles them)
-----END RSA PRIVATE KEY-----

# ── Kalshi legacy credentials (email/password — deprecated) ───────────────────
# Kalshi no longer supports email/password authentication.
# Leave these commented out unless you have a specific reason to use them.
# KALSHI_EMAIL=your_kalshi_email@example.com
# KALSHI_PASSWORD=your_kalshi_password

# ── The Odds API ───────────────────────────────────────────────────────────────
ODDS_API_KEY=your_odds_api_key_here

# ── Live trading gate — must be set explicitly to unlock live mode ─────────────
# I_UNDERSTAND_LIVE_TRADING=true

# ── Optional overrides (these shadow config.yaml values) ──────────────────────
# LOG_LEVEL=DEBUG
# ENVIRONMENT=demo
