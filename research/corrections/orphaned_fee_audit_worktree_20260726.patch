+        assert series_maker_charges_fee(s) is False, s
+    for s in ("KXPGATOP5", "KXPGATOP10", "KXLIVTOP5", "KXLIVTOP10"):
+        assert series_maker_charges_fee(s) is False, s
+
+
+def test_non_pga_tours_do_not_inherit_pga_tour_pricing():
+    """Regression guard: LPGA/LIV/Champions were wrongly marked as charging.
