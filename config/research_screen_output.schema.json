{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision": {"enum": ["reject", "defer", "deep_research"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "evidence_checked": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "research_minutes": {"type": "integer", "minimum": 0},
    "mechanism": {"type": "string"},
    "cheapest_decisive_test": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "recheck_after": {
      "anyOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "blocking_fact": {
      "type": ["string", "null"]
    },
    "notes": {"type": "string"}
  },
  "required": [
    "decision", "reason_codes", "evidence_checked", "research_minutes",
    "mechanism", "cheapest_decisive_test", "confidence",
    "recheck_after", "blocking_fact", "notes"
  ],
  "additionalProperties": false
}
