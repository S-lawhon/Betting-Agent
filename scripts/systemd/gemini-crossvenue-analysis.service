[Unit]
Description=Betting Pod Shop — bounded Gemini/Kalshi historical analysis
After=network-online.target gemini-crossvenue-research.service
Wants=network-online.target

[Service]
Type=oneshot
User=bettingbot
Group=bettingbot
WorkingDirectory=/opt/betting-pod-shop
ExecStart=/opt/betting-pod-shop/venv/bin/python -m scripts.refresh_gemini_crossvenue_analysis

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gemini-crossvenue-analysis
Nice=15
IOSchedulingClass=idle
MemoryMax=256M
TimeoutStartSec=300

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/betting-pod-shop/data/gemini_crossvenue
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
