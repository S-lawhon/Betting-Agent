{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "disposition": {
      "type": "object",
      "properties": {
        "assignment_id": {
          "type": "string"
        },
        "source_item_id": {
          "type": "string"
        },
        "decided_at": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "reject",
            "defer",
            "needs_work",
            "advance"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "research_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "opportunity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recheck_after": {
          "type": [
            "string",
            "null"
          ],
          "description": "REQUIRED (non-null) only when decision is 'defer': a timezone-aware ISO-8601 UTC timestamp for when the named external fact will exist. MUST be null for needs_work."
        },
        "blocking_fact": {
          "type": [
            "string",
            "null"
          ],
          "description": "REQUIRED when decision is defer: the named external fact that does not exist yet and will arise without research work."
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ],
          "description": "REQUIRED when decision is needs_work: the bounded dataset, collector, analysis, or implementation action."
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "source_item_id",
        "decided_at",
        "decision",
        "reason_codes",
        "evidence_checked",
        "research_minutes",
        "opportunity_id",
        "recheck_after",
        "blocking_fact",
        "next_action",
        "notes"
      ],
      "additionalProperties": false
    },
    "artifact_type": {
      "enum": [
        "opportunity_card",
        "scout_rejection",
        "research_disposition"
      ]
    },
    "artifact": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "source_agent": {
              "type": "string",
              "const": "scout"
            },
            "market_family": {
              "type": "string"
            },
            "thesis": {
              "type": "string"
            },
            "edge_source": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "external_data_needed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "urgency": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "created_at",
            "source_agent",
            "market_family",
            "thesis",
            "edge_source",
            "external_data_needed",
            "confidence",
            "urgency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_checked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "reason_codes",
            "evidence_checked"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/researchDisposition"
        }
      ]
    }
  },
  "required": [
    "disposition",
    "artifact_type",
    "artifact"
  ],
  "additionalProperties": false,
  "$defs": {
    "researchDisposition": {
      "type": "object",
      "properties": {
        "assignment_id": {
          "type": "string"
        },
        "source_item_id": {
          "type": "string"
        },
        "decided_at": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "reject",
            "defer",
            "needs_work",
            "advance"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "research_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "opportunity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recheck_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocking_fact": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "source_item_id",
        "decided_at",
        "decision",
        "reason_codes",
        "evidence_checked",
        "research_minutes",
        "opportunity_id",
        "recheck_after",
        "blocking_fact",
        "next_action",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
