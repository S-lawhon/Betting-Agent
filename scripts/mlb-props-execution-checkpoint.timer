[Unit]
Description=Update MLB props V2 execution-gate progress after each completed slate

[Timer]
# The collector stops at 23:45 ET. V2 stays outcome-blind until both its 27th
# clean game-day and the locked 2026-09-15 00:30 ET earliest read.
OnCalendar=*-*-* 00:30:00 America/New_York
Persistent=true
Unit=mlb-props-execution-checkpoint.service

[Install]
WantedBy=timers.target
