+    """
+    assert series_maker_charges_fee("KXPGATOUR") is True
+    for s in ("KXLPGATOUR", "KXLIVTOUR", "KXCHAMPTOUR"):
+        assert series_maker_charges_fee(s) is False, s
+        assert fee_per_contract(0.5, maker=True, series_ticker=s) == 0.0
+
+
+def test_golf_prefix_collisions_resolve_by_longest_match():
+    """Golf repeats the KXMLB/KXMLBHR/KXMLBHRDERBY shape twice.
+
+    A charging root sits directly above free children in both cases, so these
+    only resolve correctly under longest-prefix matching.
+    """
+    # KXPGATOUR (charges) < KXPGATOURCHAMP (free participation market)
+    assert series_maker_charges_fee("KXPGATOUR") is True
+    assert series_maker_charges_fee("KXPGATOURCHAMP") is False
+    # KXPGARYDER (charges) < its free day-winner / matchup / top-scorer children
+    assert series_maker_charges_fee("KXPGARYDER") is True
+    assert series_maker_charges_fee("KXPGARYDERCUPD1") is False
+    assert series_maker_charges_fee("KXPGARYDERMATCH") is False
+    assert series_maker_charges_fee("KXPGARYDERTOP3") is False
+    # KXPGA (charges) < KXPGATOP/KXPGAMAKECUT (free) — the original golf case
+    assert series_maker_charges_fee("KXPGA") is True
+    assert series_maker_charges_fee("KXPGATOP20") is False
+    # KXRYDERCUP is a distinct root from KXPGARYDER and is free throughout
+    assert series_maker_charges_fee("KXRYDERCUP") is False
+    # KXUSOPEN (golf major, charges) must not drag down the LIV/DPW families
+    assert series_maker_charges_fee("KXUSOPEN") is True
+    assert series_maker_charges_fee("KXDPWORLDTOUR") is False
+
+
+def test_golf_full_market_tickers_resolve_to_their_family():
+    # real tickers carry an event/competitor suffix
+    assert series_maker_charges_fee("KXDPWORLDTOURMAKECUT-26JUL-RMCI") is False
+    assert series_maker_charges_fee("KXLIVTOP10-26AUG-RAHM") is False
+    assert series_maker_charges_fee("KXLIVTOP5-26AUG-RAHM") is False
+    assert series_maker_charges_fee("KXPGATOUR-26JUL") is True
+
+
