# ── Credentials — NEVER commit these ──────────────────────────────
.env
*.pem
*_private_key*
*_secret*

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Runtime data (pod logs, trade logs) ───────────────────────────
data/
*.jsonl
*.log
*.parquet

# ── OS / editor noise ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
~$*
.~lock.*#

# Fund manager — secrets and generated state
manager/manager.env
manager/state/

# secrets — belt and braces
.env*
!.env.example
_to_delete/

# Claude Code personal overrides. The tool rewrites this file every time a
# permission is approved, so tracking it means a dirty tree after every
# session and a merge conflict whenever two machines approve different things.
# Shared, portable rules belong in .claude/settings.json, which IS tracked.
.claude/settings.local.json
