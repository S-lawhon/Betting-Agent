[Unit]
Description=Betting Pod Shop — temporary autonomous Codex research window
After=network-online.target research-intake.service
Wants=network-online.target
ConditionPathExists=/var/lib/research-codex/auth.json

[Service]
Type=oneshot
User=bettingbot
Group=bettingbot
WorkingDirectory=/opt/betting-pod-shop
Environment=HOME=/var/lib/research-codex
Environment=CODEX_HOME=/var/lib/research-codex
ExecStart=/opt/betting-pod-shop/venv/bin/python -m scripts.run_codex_research_week

StandardOutput=journal
StandardError=journal
SyslogIdentifier=research-agent-codex-week
UMask=0077
Nice=15
IOSchedulingClass=idle
MemoryMax=512M
TasksMax=64
TimeoutStartSec=660

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ReadWritePaths=/opt/betting-pod-shop/data/research_execution
ReadWritePaths=/opt/betting-pod-shop/research/dispositions
ReadWritePaths=/var/lib/research-codex
InaccessiblePaths=-/opt/betting-pod-shop/.git
InaccessiblePaths=-/opt/betting-pod-shop/.env
InaccessiblePaths=-/opt/betting-pod-shop/.env.bak-portable
InaccessiblePaths=-/opt/betting-pod-shop/.env.prev-20260729154347
InaccessiblePaths=-/opt/betting-pod-shop/.env.x
InaccessiblePaths=-/opt/betting-pod-shop/kalshi_private_key.pem
InaccessiblePaths=-/opt/betting-pod-shop/Legacy
