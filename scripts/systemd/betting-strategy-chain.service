[Unit]
Description=Betting Pod Shop — bounded strategy-chain role worker
After=network-online.target betting-strategy-agents.service
Wants=network-online.target
ConditionPathExists=/var/lib/research-codex/auth.json

[Service]
Type=oneshot
SuccessExitStatus=0 1
User=bettingbot
Group=bettingbot
WorkingDirectory=/opt/betting-pod-shop
Environment=HOME=/var/lib/research-codex
Environment=CODEX_HOME=/var/lib/research-codex
ExecStart=/opt/betting-pod-shop/venv/bin/python -m scripts.run_strategy_chain_worker --execute
StandardOutput=journal
StandardError=journal
SyslogIdentifier=betting-strategy-chain
UMask=0077
Nice=15
MemoryMax=768M
TasksMax=64
TimeoutStartSec=960
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/betting-pod-shop/data/strategy_agents
ReadWritePaths=/var/lib/research-codex
InaccessiblePaths=-/opt/betting-pod-shop/.git
InaccessiblePaths=-/opt/betting-pod-shop/.env
InaccessiblePaths=-/opt/betting-pod-shop/kalshi_private_key.pem
InaccessiblePaths=-/opt/betting-pod-shop/Legacy

[Install]
WantedBy=multi-user.target
