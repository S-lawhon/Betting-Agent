+    assert fee_per_contract(0.5, maker=False, series_ticker=series) \
+        == pytest.approx(0.0175)
+
+
+def test_makecut_and_topn_families_across_all_tours():
+    """The 2026-07-26 gap: make-cut and top-N were only mapped for the PGA.
+
+    DP World make-cut and LIV top-5/top-10 fell through to the general 0.0175
+    maker rate (~0.44c at 50c) on series Kalshi charges nothing for.
+    """
