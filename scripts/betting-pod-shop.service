[Unit]
Description=Betting Pod Shop — Multi-Pod Scan Engine
Documentation=https://github.com/samlawhon/betting-pod-shop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as dedicated service account (see server_setup.sh for user creation)
User=bettingbot
Group=bettingbot
WorkingDirectory=/opt/betting-pod-shop

# Legacy scanner src/ on PYTHONPATH so `from scanner import Scanner` etc. resolve.
# engine.py also does sys.path.insert() at module level, but belt-and-suspenders.
Environment="PYTHONPATH=/opt/betting-pod-shop/Legacy/Kalshi Arb Project/src"

# __PYTHON__ is replaced by server_setup.sh with the real venv Python path
ExecStart=__PYTHON__ -m src.main --loop --interval 300 --web --no-browser

# Restart automatically if the engine crashes, with a 30-second cooldown
Restart=on-failure
RestartSec=30

# Give the network 10 seconds to settle before first scan
ExecStartPre=/bin/sleep 10

# ── Logging ─────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=betting-pod-shop

# ── Memory ──────────────────────────────────────────────────────────────────
# This was the ONLY unit on the 2 GB box without a cap, and it is the one that
# OOM-crash-looped for five weeks in June 2026. Every other unit here sets one
# (256M–512M); the engine is the priority workload so it gets the largest share,
# but "largest" is not "unbounded".
#
# Deliberately NO Nice/IOSchedulingClass here: unlike the collectors, the engine
# must not yield — it is the thing everything else exists to serve.
#
# 640M is a starting ceiling, not a measurement. Tighten it after a week of:
#   systemctl show -p MemoryPeak betting-pod-shop
# Two defences keep real usage well under it: trade_store's
# max_load_entries: 50000, and the dashboard's 400-row trade cap — which also
# removed the unbounded list that used to be serialised into every HTTP response
# from inside this process.
MemoryMax=640M

# ── Security hardening ──────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/betting-pod-shop/data /opt/betting-pod-shop/output.log

# Allow network access (needed for API calls) but nothing else
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
