[Unit]
Description=La Liga spread public information-latency collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bettingbot
Group=bettingbot
WorkingDirectory=/opt/betting-pod-shop
ExecStart=/opt/betting-pod-shop/venv/bin/python /opt/betting-pod-shop/soccer_research/laliga_spread_latency.py --run --interval 10
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=laliga-spread-latency
UMask=0077
Nice=15
IOSchedulingClass=idle
MemoryMax=256M
TasksMax=32
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/betting-pod-shop/data/laliga_spread_latency
InaccessiblePaths=-/opt/betting-pod-shop/.git
InaccessiblePaths=-/opt/betting-pod-shop/.env
InaccessiblePaths=-/opt/betting-pod-shop/kalshi_private_key.pem

[Install]
WantedBy=multi-user.target
