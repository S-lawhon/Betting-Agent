[Unit]
Description=Evaluate the preregistered La Liga spread latency gate
After=network-online.target

[Service]
Type=oneshot
User=bettingbot
Group=bettingbot
WorkingDirectory=/opt/betting-pod-shop
ExecStart=/opt/betting-pod-shop/venv/bin/python /opt/betting-pod-shop/soccer_research/laliga_spread_latency.py --analyze
StandardOutput=journal
StandardError=journal
SyslogIdentifier=laliga-spread-latency-analysis
UMask=0077
Nice=15
IOSchedulingClass=idle
MemoryMax=512M
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/opt/betting-pod-shop/data/laliga_spread_latency
InaccessiblePaths=-/opt/betting-pod-shop/.git
InaccessiblePaths=-/opt/betting-pod-shop/.env
InaccessiblePaths=-/opt/betting-pod-shop/kalshi_private_key.pem

